# All variables are REQUIRED at runtime for their feature to function.
# Nothing has a fallback — missing config fails closed (503), never silently.

# Azure AD (existing app registration; values live in Vercel env, never in the repo)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=https://localhost:3002/api/auth/callback

# Session signing (>= 32 chars, random)
SESSION_SECRET=

# Control-plane database (the NEW v2 Supabase project — founder creates at Phase 2)
DATABASE_URL=

# Envelope-encryption master key (base64, 32 bytes). KMS replaces this later.
MASTER_KEY_B64=

# Central platform-admin secret (guards /api/platform/* — the control plane)
PLATFORM_ADMIN_SECRET=
